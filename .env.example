# ==============================================================================
# AlertIQ — Environment Configuration Template
# ==============================================================================
# Note: Keep secrets server-side. Never prefix sensitive API keys with NEXT_PUBLIC_.
# If keys are omitted, AlertIQ automatically runs in honest Simulated Rule Mode (Demo).
# ==============================================================================

# Google Gemini API Key (Required for live LLM multi-vector scam analysis)
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Google Gemini Model Identifier (Default: gemini-2.5-flash)
# Supported options: gemini-2.5-flash, gemini-2.5-pro
GEMINI_MODEL=gemini-2.5-flash

# Google Safe Browsing Lookup API v4 Key (Optional)
# Enables external reputation validation of candidate URLs extracted from messages.
# If omitted, AlertIQ executes domain heuristic scanning (punycode, brand impersonation, deceptive hosts).
GOOGLE_SAFE_BROWSING_API_KEY=your_safe_browsing_api_key_here
