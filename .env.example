# ==============================================================================
# AlertIQ — Environment Configuration Template
# ==============================================================================

# Groq Cloud API Key (Ultra-fast LLM inference via Llama 3.3 70B)
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq Model Identifier (Default: llama-3.3-70b-versatile)
# Supported options: llama-3.3-70b-versatile, llama-3.1-8b-instant
GROQ_MODEL=llama-3.3-70b-versatile

# Google Safe Browsing Lookup API v4 Key (Optional)
# If omitted, AlertIQ automatically uses its built-in domain heuristic scanner.
GOOGLE_SAFE_BROWSING_API_KEY=your_safe_browsing_api_key_here
